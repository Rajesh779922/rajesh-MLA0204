import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

# Create sample dataset
data = {
    'Area': [1000, 1200, 1500, 1800, 2000,
             2200, 2500, 2800, 3000, 3200],
    'Bedrooms': [2, 2, 3, 3, 3, 4, 4, 4, 5, 5],
    'Age': [10, 8, 7, 6, 5, 4, 3, 2, 2, 1],
    'Price': [2000000, 2400000, 3000000, 3600000,
              4000000, 4400000, 5000000, 5600000,
              6000000, 6400000]
}

df = pd.DataFrame(data)

# Features and target
X = df[['Area', 'Bedrooms', 'Age']]
y = df['Price']

# Create and train model
model = LinearRegression()
model.fit(X, y)

# Prediction
y_pred = model.predict(X)

print("Actual House Prices:")
print(y.values)

print("\nPredicted House Prices:")
print(y_pred.round(2))

# Evaluation
print("\nMean Squared Error:",
      round(mean_squared_error(y, y_pred), 2))

print("R2 Score:", round(r2_score(y, y_pred), 2))

# New house prediction
new_house = pd.DataFrame(
    [[1800, 3, 5]],
    columns=['Area', 'Bedrooms', 'Age']
)

price = model.predict(new_house)

print("\nPredicted House Price: Rs.",
      round(price[0], 2))
